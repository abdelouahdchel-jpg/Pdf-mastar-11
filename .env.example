# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE ADSENSE MONETIZATION CONFIGURATION:
# 1. Sign in to your Google AdSense account (https://adsense.google.com).
# 2. Add your custom domain in Sites and copy your Publisher Client ID (format: ca-pub-XXXXXXXXXXXXXXXX).
# 3. Create responsive display ad units in Ads > By ad unit, and copy their numeric Slot IDs.
# Note: Advertising remains completely disabled if VITE_ADSENSE_CLIENT_ID is empty or missing.
VITE_ADSENSE_CLIENT_ID="ca-pub-1555504428910902"

# Ad Unit Slot IDs for responsive placement containers:
VITE_ADSENSE_SLOT_HOME_TOP=""
VITE_ADSENSE_SLOT_HOME_MID=""
VITE_ADSENSE_SLOT_TOOL_BOTTOM=""
VITE_ADSENSE_SLOT_FOOTER=""
